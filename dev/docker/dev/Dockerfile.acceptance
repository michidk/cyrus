FROM ubuntu:26.04@sha256:6a06111c3b0a8600feadb270aec771dc239bf407b25625f93f44ab00e11f4d3c
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends xvfb mesa-vulkan-drivers libasound2t64 libudev1 libxkbcommon0 libxkbcommon-x11-0 libwayland-client0 libx11-6 libxcursor1 libxi6 libxrandr2 && rm -rf /var/lib/apt/lists/*
COPY entrypoint-acceptance.sh /entrypoint.sh
ENTRYPOINT ["/bin/bash", "/entrypoint.sh"]
