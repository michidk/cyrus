# Unattended original contact probes use X input and state diagnostics, not VNC.
FROM ubuntu:26.04@sha256:6a06111c3b0a8600feadb270aec771dc239bf407b25625f93f44ab00e11f4d3c
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        dosbox-x xvfb xdotool python3-minimal \
    && rm -rf /var/lib/apt/lists/*
COPY contact-entrypoint.sh /usr/local/bin/contact-entrypoint.sh
COPY dosbox-x.conf /etc/cyrus/dosbox-x.conf
ENTRYPOINT ["bash", "/usr/local/bin/contact-entrypoint.sh"]
