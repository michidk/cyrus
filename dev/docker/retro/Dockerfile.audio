# Built by ensure-retro-audio-runtime.sh with its validated dosbox-build context.
FROM ubuntu:26.04@sha256:d66b366dac61b575bee2aef07e9c26e8070096fbe84a3d4d3eb0da069b5d76db
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    dosbox-x xvfb x11vnc novnc websockify x11-utils xdotool scrot python3-pil \
    libgl1-mesa-dri mesa-utils ca-certificates pulseaudio pulseaudio-utils libasound2-plugins \
    && rm -rf /var/lib/apt/lists/*
COPY --from=dosbox-build /dosbox-x /usr/bin/dosbox-x
COPY dev/docker/retro/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY dev/docker/retro/dosbox-x.conf /etc/cyrus/dosbox-x.conf
RUN printf '%s\n' 'single-cd-volume-v1' > /etc/cyrus/audio-reference
ENTRYPOINT ["bash", "/usr/local/bin/entrypoint.sh"]
