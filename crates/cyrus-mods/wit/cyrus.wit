/// The cyrus mod API: one resource per hook. Mods query the component of the
/// same name (it lives on a single host entity) and wrap it with the resource.
/// Query `camera`, `movement`, `collision`, `natives`, `memory`, `uniforms`, `particles`, `geometry` and `hud` with `QueryFor::Mut` and `input`, `settings`,
/// `player`, `damage`, `terrain` and `scene` with `QueryFor::Ref`;
/// wasvy rejects method calls through the other mutability. Method names are
/// single words because wasvy looks host methods up by their WIT name verbatim.
package cyrus:mods@0.1.0;

interface components {
  /// Read-only unclipped terrain. A revision expires on world or binding replacement.
  /// wasvy:type-path=cyrus_mods::terrain::Terrain
  resource terrain {
    constructor(component: component);
    /// 0 ready, 1 loading, 2 no world/terrain, 3 stale revision, 4 unsupported, 5 over budget.
    status: func(revision: u64) -> u32;
    revision: func() -> option<u64>;
    /// Half-open [min x,min z,max x,max z], maximum width/depth 512 scene units.
    /// A triangle belongs to the region containing its centroid. Offset counts matching
    /// triangles, limit is 1..=512. Each returned record has 17 floats: texture index,
    /// triangle ID, then three corners [scene x,y,z,u,v]. UVs retain source rotation.
    /// IDs expire with revision. None means invalid arguments, stale or unavailable;
    /// status(revision) distinguishes those cases. An empty page is a successful end.
    triangles: func(revision: u64, bounds: list<f32>, offset: u32, limit: u32) -> option<list<f32>>;
    dimensions: func(revision: u64, texture: u32) -> option<list<u32>>;
    /// RGBA8 rectangle, up to 65536 pixels, within the snapshot image dimensions.
    /// Images are at most 512x512; snapshots cap 256 images and 1000000 triangles.
    pixels: func(revision: u64, texture: u32, x: u32, y: u32, width: u32, height: u32) -> option<list<u8>>;
  }
  /// Owner-scoped indexed meshes in scene coordinates, Y up. All requests validate
  /// before render allocation. Twelve floats per vertex: position, normal, UV, linear RGBA.
  /// Disable, successful reload and world replacement remove meshes and materials.
  /// wasvy:type-path=cyrus_mods::geometry::Geometry
  resource geometry {
    constructor(component: component);
    contains: func(owner: string, key: string) -> bool;
    generation: func() -> option<u64>;
    /// Opaque instance/revision pair; empty when unavailable. Changes after successful
    /// Wasm reload or reactivation. Persist and compare it to invalidate guest caches.
    lease: func(owner: string) -> list<u64>;
    /// Up to 256 keys and 1500000 vertices per owner, 3000000 vertices globally.
    /// Nonzero finite normals; finite position/UV within +/-1e6; linear RGBA 0..=1.
    /// Triangle indices must be in range, at most six indices per vertex.
    /// Invalid or exhausted requests preserve the previous key atomically.
    /// parameters are four shader values plus nonnegative bounds padding, all finite within +/-100.
    /// 0 accepted, 1 unavailable/stale, 2 invalid, 3 budget exceeded.
    replace: func(owner: string, key: string, revision: u64, vertices: list<f32>, indices: list<u32>, parameters: list<f32>) -> u32;
    remove: func(owner: string, key: string);
  }

  /// Accepted health reductions since the previous frame, shared read-only by all mods.
  /// Events are published in PreUpdate, including player and other actor health services.
  /// Healing, blocked hits and direct attribute edits are not damage-service events.
  /// wasvy:type-path=cyrus_mods::api::Damage
  resource damage {
    constructor(component: component);
    count: func() -> u32;
    actor: func(index: u32) -> string;
    loss: func(index: u32) -> u32;
    /// Map-unit position in original axes, or empty if spatial state was unavailable.
    position: func(index: u32) -> list<f32>;
    /// Known combat attacker position in map units, otherwise empty. Not a weapon trajectory.
    source: func(index: u32) -> list<f32>;
  }

  /// GPU particle bursts using Hanabi. Coordinates, speed and acceleration use scene
  /// units and axes. Game time controls lifetime. No surface decals or collision.
  /// Disable/reload removes the owner's effects; world replacement removes all effects.
  /// wasvy:type-path=cyrus_mods::particles::Particles
  resource particles {
    constructor(component: component);
    /// position, nonzero direction and acceleration have three finite values within +/-1e6.
    /// color is sRGB RGBA in 0..=1. speed, radius and lifetime are ordered [min,max] pairs:
    /// speed 0..=1000, radius 0.001..=10, lifetime 0.01..=10 seconds.
    /// spread 0..=1 bounds lateral velocity relative to the forward velocity.
    /// stretch 1..=8 elongates droplets along velocity. count 1..=64.
    /// Returns false for invalid or over-budget requests. Queued/live particle limits:
    /// 256 per owner, 1024 total. Overflow drops entire bursts.
    burst: func(owner: string, position: list<f32>, direction: list<f32>, acceleration: list<f32>, color: list<f32>, speed: list<f32>, radius: list<f32>, lifetime: list<f32>, spread: f32, stretch: f32, count: u32) -> bool;
  }
  use wasvy:ecs/app@0.0.11.{component};

  /// Values the game publishes by name, and its clock. Published today: "water-wave", the
  /// loaded world's wave amplitude, speed and frequency (WLD units), while it has water.
  /// "water-cell" is the terrain grid cell size in scene units, and "lighting-modern" is 1 while
  /// the Lighting area is Modern, else 0.
  /// wasvy:type-path=cyrus_mods::api::Scene
  resource scene {
    constructor(component: component);
    /// The values published under `key`; empty when none are.
    values: func(key: string) -> list<f32>;
    /// Presentation clock in seconds.
    seconds: func() -> f32;
  }

  /// The view camera. A mod that takes it over each frame suppresses player input.
  /// wasvy:type-path=cyrus_mods::api::Camera
  resource camera {
    constructor(component: component);
    /// Current view pose: x, y, z, then rotation quaternion x, y, z, w.
    pose: func() -> list<f32>;
    /// Drive the camera this frame with a pose in the same layout as `pose`.
    drive: func(pose: list<f32>);
    /// This frame the mouse and right stick turn the follow camera around the player as the
    /// Modern camera does, with the cursor captured, whatever moves the player. Call it every
    /// frame you want it.
    orbit: func();
    /// Turn the orbit camera by `amount` heading units (2048 per turn, positive left).
    /// Call with orbit each frame; mouse/right-stick input takes priority. Does not take over
    /// the view pose or suppress player input. Nonfinite amounts are ignored.
    turn: func(amount: f32);
    /// Whether manual mouse/right-stick camera input was recently sampled.
    manual: func() -> bool;
  }

  /// The player's movement. While a mod steers every frame, the player moves relative to the
  /// camera and the original movement keys keep only their other actions; when it stops,
  /// the original controls return.
  /// wasvy:type-path=cyrus_mods::api::Movement
  resource movement {
    constructor(component: component);
    /// Steer toward `x` (right) and `y` (forward) relative to the camera. Zero stands still.
    /// A length below 0.75 walks and from 0.75 runs. `jump` jumps this frame. Set `wasd` when
    /// the mod reads W, A, S and D, so the game's own actions on those keys stay quiet.
    steer: func(x: f32, y: f32, jump: bool, wasd: bool);
    /// Play animation `group` on the player (its number, as a script's `PlayAnimation` takes it
    /// and `player.animation` reports it). With `interrupt` the current group gives way now;
    /// without, the request waits like the original's: it follows the current group at its exit,
    /// by request priority. Like `face`, it applies after the original controller ran, and only
    /// on an update the controller runs (not while a script, death or another owner moves the
    /// player), so the mod's choice wins over the original's. Call it each frame you want it.
    play: func(group: u32, interrupt: bool);
    /// Face `heading` (engine units, 2048 to a turn) this frame, after the original controller.
    face: func(heading: u32);
    /// Play the player's animation `scale` times as fast this frame (1 is the original pace,
    /// at most 8). Markers in the animation, such as a jump's take-off, arrive sooner; arithmetic
    /// on the game clock (a jump's arc, a fall) keeps its pace. Applies like `play`.
    tempo: func(scale: f32);
    /// Take over the player's ground locomotion for this frame: the original bindings read as
    /// released and the original turn, walk, run and jump selection do not run. Face `heading`
    /// (engine units, 2048 to a turn) and move along `travel` (same units) `speed` map units per
    /// nominal update (see `player.speed`), walking or running; zero speed stands. The distance
    /// is covered from the first frame: the animation (forward, backward or a sidestep, by
    /// `travel` against `heading`) only shows it. `jump` starts the original
    /// jump. The engine still resolves ground, slopes and collision, and keeps death, dialogue
    /// and combat; it keeps control while the player is airborne or a script moves it. A claim
    /// lasts one frame, so call it every frame; when a mod stops, the original controls return.
    claim: func(heading: u32, travel: u32, speed: f32, run: bool, jump: bool);
    /// Scale the player's jump while it is claimed: `jump-height` times the jump height (and the
    /// descent of a fall, up to the attribute's byte limit) and `jump-speed` times the forward
    /// speed of a walking or running jump, whose distance cap stays. Only a player on the ground
    /// takes a change, so a jump in flight keeps its values. Call it each frame with `claim`; 1
    /// and 1 are the original.
    tune: func(jump-height: f32, jump-speed: f32);
  }

  /// Script natives (SOUP commands) mod authors can watch. `watch` a native by its installed
  /// `SOUP386.DEF` name (case-insensitive) every frame you want its calls; a frame later `count`,
  /// `function`, `actor` and `arguments` report each call made while it was watched, oldest first:
  /// the function name, the script name of the actor that called it and its integer arguments
  /// (actor and string arguments are left out). Only the call that starts a task is reported,
  /// not its later continuation. A call is observed, never changed. At most 4096 calls are kept
  /// per frame.
  /// wasvy:type-path=cyrus_mods::api::Natives
  resource natives {
    constructor(component: component);
    watch: func(function: string);
    count: func() -> u32;
    function: func(index: u32) -> string;
    actor: func(index: u32) -> string;
    arguments: func(index: u32) -> list<s32>;
  }

  /// Collision questions for a mod that owns the player's movement. A probe is a segment in map
  /// units and the original axes (like `player.position`). While a mod claims locomotion the
  /// engine answers the probes queued the frame before against the static model faces it has
  /// gathered near the player and against the terrain surface, and reports where each segment
  /// first meets one. Geometry beyond that neighbourhood is not seen. Queue the same probes
  /// every frame; an answer arrives two frames after its `cast`, in the order cast.
  /// wasvy:type-path=cyrus_mods::api::Collision
  resource collision {
    constructor(component: component);
    cast: func(sx: f32, sy: f32, sz: f32, ex: f32, ey: f32, ez: f32);
    /// Probe number `index` of the last answered batch: the contact point x, y, z then its
    /// unit normal x, y, z; empty when the segment hit nothing or nothing was answered.
    hit: func(index: u32) -> list<f32>;
  }

  /// The selected player's state (empty before a world has one).
  /// wasvy:type-path=cyrus_mods::api::Player
  resource player {
    constructor(component: component);
    /// x, y, z in map units, original axes.
    position: func() -> list<f32>;
    /// Facing, in engine units (2048 to a turn).
    heading: func() -> u32;
    /// The direction the camera looks, in the same units as `heading`: the heading a
    /// player facing forward through the screen has.
    view: func() -> u32;
    /// A jump or fall is in progress.
    airborne: func() -> bool;
    /// A weapon is drawn or the combat stance is on: claimed walking and running then use the
    /// fight animations, and `speed` the fight speeds.
    armed: func() -> bool;
    /// The player's walking or running speed, in map units per nominal update.
    speed: func(run: bool) -> f32;
    /// The playing animation group, the group waiting to follow it, and the group the player
    /// returns to when nothing is requested; each one value, or empty when there is none.
    animation: func() -> list<u32>;
    pending: func() -> list<u32>;
    idle: func() -> list<u32>;
  }

  /// The player's values for the `[[setting]]` entries in mod.toml. `id` is the mod's folder
  /// name and `key` the setting's key; a name that is not declared reads false, 0 or "".
  /// wasvy:type-path=cyrus_mods::api::Settings
  resource settings {
    constructor(component: component);
    flag: func(id: string, key: string) -> bool;
    number: func(id: string, key: string) -> f32;
    choice: func(id: string, key: string) -> string;
  }

  /// Values a mod keeps between frames. wasvy starts a fresh instance of the mod for every
  /// system call, so a mod's own variables do not survive to the next frame; keep state here.
  /// Keys are shared by all mods, so prefix them with the mod's folder name. The values last
  /// for the session and are not saved.
  /// wasvy:type-path=cyrus_mods::api::Memory
  resource memory {
    constructor(component: component);
    /// The values saved under `key`, or empty when nothing is.
    load: func(key: string) -> list<f32>;
    /// Keep `values` under `key`; empty values forget it.
    save: func(key: string, values: list<f32>);
  }

  /// Four-value inputs the game's shaders read, by name. Read today: "water-surface" =
  /// `[effects, 0, amplitude, cell]`: `effects` above zero turns on the shader's shore foam, wet
  /// sand and ripples; a positive `amplitude` also moves the waves in the terrain shader, `cell`
  /// being the grid cell size in scene units (the "water-cell" scene value). Write every frame;
  /// when a mod stops, the shaders return to the original.
  /// wasvy:type-path=cyrus_mods::api::Uniforms
  resource uniforms {
    constructor(component: component);
    set: func(key: string, values: list<f32>);
  }

  /// Text lines drawn in the top-left corner over the game. A line shows for the frame it was
  /// written in, so call `show` every frame the text should stay; when a mod stops, it disappears.
  /// wasvy:type-path=cyrus_mods::api::Hud
  resource hud {
    constructor(component: component);
    show: func(line: string);
  }

  /// Keyboard and mouse this frame; `tapped` means pressed this frame. Keys use Bevy `KeyCode` names such as
  /// "KeyW", "Space", "ShiftLeft" or "F11".
  /// wasvy:type-path=cyrus_mods::api::Input
  resource input {
    constructor(component: component);
    /// Whether the player holds an action under the game's own key bindings (KEYS.INI):
    /// "forward", "back", "left", "right", "walk" (the walk/run modifier) or "jump".
    held: func(action: string) -> bool;
    pressed: func(key: string) -> bool;
    tapped: func(key: string) -> bool;
    /// Mouse motion since the last frame in pixels: x, y.
    mouse: func() -> list<f32>;
    /// Seconds since the last frame.
    delta: func() -> f32;
  }
}

world host {
  import components;
}
