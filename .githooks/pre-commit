#!/usr/bin/env bash
# Refuses commits that would publish working memory or game data (rule 1 in AGENTS.md).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if git diff --cached --name-only | grep -E '^(magic|cyrus-config|redguard)(/|$)'; then
    echo "pre-commit: refusing to commit working memory or the install link" >&2
    exit 1
fi
if git diff --cached --name-only | grep -iE '\.(3d|3dc|rob|rgm|wld|col|pvo|gxa|bsi|sfx|rtx|fnt|cht|gog|ins|exe|swg|swx|glb|png)$'; then
    echo "pre-commit: refusing to commit game or image files" >&2
    exit 1
fi
