{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>michidk/workflows//templates/presets/renovate"
  ],
  "packageRules": [
    {
      "description": "Keep direct audio types compatible with Bevy and the patched Rodio backend.",
      "matchPackageNames": [
        "rodio"
      ],
      "allowedVersions": "=0.22.2"
    },
    {
      "description": "Follow the inspector port matching the workspace Bevy version.",
      "matchPackageNames": [
        "bevy-inspector-egui"
      ],
      "followTag": "bevy-0.20"
    }
  ]
}
