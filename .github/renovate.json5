{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>michidk/workflows//templates/presets/renovate"
  ],
  "packageRules": [
    {
      "description": "The vendored CPAL provides browser scheduling fixes and Linux mixer diagnostics; upgrades require porting those patches.",
      "matchPackageNames": [
        "cpal"
      ],
      "enabled": false
    },
    {
      "description": "Keep direct audio types compatible with Bevy and the patched Rodio backend.",
      "matchPackageNames": [
        "rodio"
      ],
      "allowedVersions": "=0.22.2"
    }
  ]
}
